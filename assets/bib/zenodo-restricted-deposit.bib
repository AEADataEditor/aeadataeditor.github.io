@techreport{ahrsjoCodeIdentityCourt2024,
  title = {Code for {{Identity}} in {{Court Decision-Making}}},
  author = {Ahrsj{\"o}, Ulrika and Niknami, Susan and Palme, M{\aa}rten},
  year = {2024},
  series = "American Economic Association [publisher]",
  institution = {{ICPSR - Interuniversity Consortium for Political and Social Research}},
  doi = {10.3886/E193364V1},
  url = {https://doi.org/10.3886/E193364V1},
  urldate = {2025-02-06},
  abstract = {This project contains all code used to conduct the empirical analysis of the paper Identity in Court Decision-Making by Ahrsjo, Niknami and Palme. Additionally, we describe and provide information about access to a data set created from court documents from the Stockholm District Court.{$<$}br{$><$}br{$>$}Abstract: We explore the role of identity along multiple dimensions in high-stakes decision-making. Our data contain information about demographic and socioeconomic indicators for defendants and randomly assigned jurors in a Swedish court. Our results show that defendants are four to six percent less likely to get a prison sentence if judged by one more juror belonging to the same identity-forming group. Moreover, they are given ten percent shorter prison sentences. Socioeconomic background and demographic attributes are equally important for identity effects, and these effects stem from trials of longer duration and where the defendant is present in the courtroom.{$<$}br{$>$}},
  langid = {english},
  keywords = {criminal courts,criminal justice policy,demographic characteristics,social identity,socioeconomic status}
}

